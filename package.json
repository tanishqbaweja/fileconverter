{
  "name": "within-file-converter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test tests/rendered-html.test.mjs",
    "test:browser": "playwright test",
    "fixtures:generate": "node scripts/generate-fixtures.mjs",
    "fixtures:stress": "node scripts/generate-stress-fixture.mjs",
    "fixtures:gzip-stress": "node scripts/generate-gzip-stress-fixture.mjs",
    "fixtures:media": "node scripts/generate-media-fixture.mjs",
    "fixtures:inspect-test-mkv": "node scripts/inspect-test-fixture.mjs",
    "fixtures:media-stress": "node scripts/generate-media-stress-fixture.mjs",
    "build:ffmpeg-remux": "docker build --file media/ffmpeg/Dockerfile --output type=local,dest=public/engines/remux media/ffmpeg",
    "profile:memory": "node scripts/memory-profile.mjs",
    "clean:generated": "node scripts/cleanup-generated.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}

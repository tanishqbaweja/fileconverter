{
  "name": "within-file-converter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && npm run test:unit",
    "test:unit": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "tested:ledger": "node scripts/generate-tested-ledger.mjs",
    "fixtures:generate": "node scripts/generate-fixtures.mjs",
    "fixtures:stress": "node scripts/generate-stress-fixture.mjs",
    "fixtures:gzip-stress": "node scripts/generate-gzip-stress-fixture.mjs",
    "fixtures:media": "node scripts/generate-media-fixture.mjs",
    "fixtures:mov": "node scripts/generate-mov-fixture.mjs",
    "fixtures:mov-stress": "node scripts/generate-mov-stress-fixture.mjs",
    "fixtures:3gp": "node scripts/generate-3gp-fixture.mjs",
    "fixtures:3gp-stress": "node scripts/generate-3gp-stress-fixture.mjs",
    "fixtures:mpeg-ts": "node scripts/generate-mpeg-ts-fixture.mjs",
    "fixtures:mpeg-ts-stress": "node scripts/generate-mpeg-ts-stress-fixture.mjs",
    "fixtures:flv": "node scripts/generate-flv-fixture.mjs",
    "fixtures:flv-stress": "node scripts/generate-flv-stress-fixture.mjs",
    "fixtures:avi": "node scripts/generate-avi-fixture.mjs",
    "fixtures:avi-stress": "node scripts/generate-avi-stress-fixture.mjs",
    "fixtures:ogv": "node scripts/generate-ogv-fixture.mjs",
    "fixtures:ogv-stress": "node scripts/generate-ogv-stress-fixture.mjs",
    "fixtures:mpeg2-video": "node scripts/generate-mpeg2-video-fixture.mjs",
    "fixtures:mpeg2-video-stress": "node scripts/generate-mpeg2-video-stress-fixture.mjs",
    "fixtures:audio-stress": "node scripts/generate-audio-stress-fixture.mjs",
    "fixtures:aac": "node scripts/generate-aac-fixture.mjs",
    "fixtures:aac-stress": "node scripts/generate-aac-stress-fixture.mjs",
    "fixtures:images": "node scripts/generate-image-fixtures.mjs",
    "fixtures:records-stress": "node scripts/generate-record-stress-fixtures.mjs",
    "fixtures:subtitles-stress": "node scripts/generate-subtitle-stress-fixtures.mjs",
    "fixtures:documents-stress": "node scripts/generate-document-stress-fixtures.mjs",
    "fixtures:docx": "node scripts/generate-docx-fixtures.mjs",
    "fixtures:epub": "node scripts/generate-epub-fixtures.mjs",
    "fixtures:xlsx": "node scripts/generate-xlsx-fixtures.mjs",
    "fixtures:pptx": "node scripts/generate-pptx-fixtures.mjs",
    "fixtures:odf": "node scripts/generate-odf-fixtures.mjs",
    "fixtures:odt-stress": "node scripts/generate-open-document-stress-fixture.mjs odt",
    "fixtures:ods-stress": "node scripts/generate-open-document-stress-fixture.mjs ods",
    "fixtures:odp-stress": "node scripts/generate-open-document-stress-fixture.mjs odp",
    "fixtures:presentations-stress": "node scripts/generate-presentation-stress-fixtures.mjs",
    "fixtures:spreadsheets-stress": "node scripts/generate-spreadsheet-stress-fixtures.mjs",
    "fixtures:ebooks-stress": "node scripts/generate-ebook-stress-fixtures.mjs",
    "fixtures:archives": "node scripts/generate-archive-fixtures.mjs",
    "fixtures:archives:stress": "node scripts/generate-archive-fixtures.mjs --include-stress",
    "fixtures:inspect-test-mkv": "node scripts/inspect-test-fixture.mjs",
    "fixtures:media-stress": "node scripts/generate-media-stress-fixture.mjs",
    "build:ffmpeg-remux": "docker build --file media/ffmpeg/Dockerfile --output type=local,dest=public/engines/remux media/ffmpeg",
    "profile:memory": "node scripts/memory-profile.mjs",
    "profile:category": "node scripts/profile-category.mjs",
    "profile:audio": "node scripts/profile-category.mjs audio",
    "profile:aac": "node scripts/profile-category.mjs aac",
    "profile:mov": "node scripts/profile-category.mjs mov",
    "profile:3gp": "node scripts/profile-category.mjs 3gp",
    "profile:mpeg-ts": "node scripts/profile-category.mjs mpeg-ts",
    "profile:flv": "node scripts/profile-category.mjs flv",
    "profile:avi": "node scripts/profile-category.mjs avi",
    "profile:ogv": "node scripts/profile-category.mjs ogv",
    "profile:mpeg2-video": "node scripts/profile-category.mjs mpeg2-video",
    "profile:images": "node scripts/profile-category.mjs images",
    "profile:records": "node scripts/profile-category.mjs records",
    "profile:records-direct-json": "node scripts/profile-category.mjs records-csv-json && node scripts/profile-category.mjs records-tsv-json && node scripts/profile-category.mjs records-json-delimited",
    "profile:subtitles": "node scripts/profile-category.mjs subtitles",
    "profile:documents": "node scripts/profile-category.mjs documents",
    "profile:ebooks": "node scripts/profile-category.mjs ebooks",
    "profile:spreadsheets": "node scripts/profile-category.mjs spreadsheets",
    "profile:presentations": "node scripts/profile-category.mjs presentations",
    "profile:open-documents": "node scripts/profile-category.mjs odt && node scripts/profile-category.mjs ods && node scripts/profile-category.mjs odp",
    "profile:archives": "node scripts/profile-category.mjs archives",
    "clean:generated": "node scripts/cleanup-generated.mjs",
    "clean:test-artifacts": "node scripts/cleanup-generated.mjs --test-artifacts-only",
    "clean:benchmark-artifacts": "node scripts/cleanup-generated.mjs --benchmark-artifacts-only",
    "clean:reports": "node scripts/cleanup-generated.mjs --prune-reports-only",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}

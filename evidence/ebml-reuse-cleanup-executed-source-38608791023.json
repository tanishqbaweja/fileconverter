xe\", args, { cwd: root, env: runtime.env, windowsHide: true, timeout: 30000, maxBuffer: 65536 })).stdout;\nlet before, after;\ntry {\n  before = JSON.parse(await call([\"api\", `repos/${repo}/actions/artifacts/${proof.artifact.id}`]));\n  assert.equal(before.id, proof.artifact.id); assert.equal(before.name, proof.artifact.name);\n  assert.equal(before.workflow_run.id, proof.run.databaseId); assert.equal(before.workflow_run.head_sha, proof.run.headSha);\n  assert.equal(before.size_in_bytes, proof.artifact.size_in_bytes); assert.equal(before.digest, proof.artifact.digest); assert.equal(before.expired, false);\n  await call([\"api\", \"--method\", \"DELETE\", `repos/${repo}/actions/artifacts/${before.id}`]);\n  after = JSON.parse(await call([\"api\", `repos/${repo}/actions/runs/${runId}/artifacts`]));\n  assert.equal(after.total_count, 0); assert.deepEqual(after.artifacts, []);\n} finally { await runtime.close(); await assert.rejects(access(runtime.directory), { code: \"ENOENT\" }); }\nawait writeFile(path.join(root, output), JSON.stringify({ recordedAt: new Date().toISOString(), status: \"source-bound-disposable-hosted-artifact-deleted-local-tools-retained\",\n  runId, proofSha256: sha(proofBytes), artifactBefore: before, artifactCountAfter: after.total_count,\n  localToolsRetained: cache, localToolBytes: proof.reusableToolBytes, recoverability: \"Verified small local build tools retained for actual browser qualification; no user files/converted media deleted\",\n  ownedRuntimeRemoved: true, publicAcceptance: false, browserConversionsPerformed: 0 }, null, 2) + \"\\n\", { flag: \"wx\" });\nconsole.log(JSON.stringify({ output, artifactDeleted: before.id, artifactCountAfter: 0, reusableLocalToolBytes: proof.reusableToolBytes }));\n",
